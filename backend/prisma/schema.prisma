generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AsignaturaPensum {
  id                Int      @id @default(autoincrement())
  clave             String   @unique
  nombre            String
  creditos          Int
  trimestreSugerido Int
  estado            String   @default("Pendiente")
  calificacion      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  asignaturasCursadas AsignaturaCursada[]
  horarios          HorarioAsignatura[]
}

model Trimestre {
  id               String   @id @default(uuid())
  periodo          String
  anio             Int?
  estado           String   @default("CERRADO")
  materiasAprobadas Int?    @default(0)
  creditosAprobados Int?    @default(0)
  gpa              Float?
  indiceTrimestral Float?
  indiceAcumulado  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  asignaturas      AsignaturaCursada[]
}

model AsignaturaCursada {
  id              String           @id @default(uuid())
  trimestreId     String
  claveMateria    String
  calificacion    String?
  puntos          Float?
  profesor        String?
  horario         String?
  aula            String?
  trimestre       Trimestre        @relation(fields: [trimestreId], references: [id])
  asignaturaPensum AsignaturaPensum @relation(fields: [claveMateria], references: [clave])
}

model VolanteSeleccion {
  id        String   @id @default(uuid())
  periodo   String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  horarios  HorarioAsignatura[]
}

model HorarioAsignatura {
  id               String           @id @default(uuid())
  volanteId        String
  claveMateria     String
  profesor         String
  dia              String
  horas            String
  aula             String
  volante          VolanteSeleccion @relation(fields: [volanteId], references: [id])
  asignaturaPensum AsignaturaPensum @relation(fields: [claveMateria], references: [clave])
}
